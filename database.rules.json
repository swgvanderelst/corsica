{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && auth.uid === $uid",
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && auth.uid === $uid",
        ".validate": "$uid.matches(/^[-_A-Za-z0-9]{1,32}$/) && newData.hasChildren(['name', 'updatedAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "swipes": {
          ".validate": "newData.hasChildren()",
          "$card": {
            ".validate": "$card.matches(/^[-_A-Za-z0-9]{1,32}$/) && (newData.val() === -1 || newData.val() === 1 || newData.val() === 2)"
          }
        },
        "groups": {
          ".validate": "newData.hasChildren()",
          "$g": {
            ".validate": "$g.matches(/^[-_A-Za-z0-9]{1,32}$/) && newData.val() === true"
          }
        },
        "overrides": {
          ".validate": "newData.hasChildren()",
          "$t": {
            ".validate": "$t.matches(/^[a-z_]{1,24}$/) && (newData.val() === -1 || newData.val() === 0 || newData.val() === 1)"
          }
        },
        "prefs": {
          ".validate": "newData.hasChildren()",
          "airco": {
            ".validate": "newData.isBoolean()"
          },
          "ev": {
            ".validate": "newData.isBoolean()"
          },
          "kids": {
            ".validate": "newData.isBoolean()"
          },
          "budget": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4 && newData.val() % 1 === 0"
          },
          "$other": {
            ".validate": false
          }
        },
        "household": {
          ".validate": "newData.hasChildren()",
          "$p": {
            ".validate": "$p.matches(/^p([0-9]|1[01])$/) && newData.hasChildren(['name'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
            },
            "born": {
              ".validate": "newData.isNumber() && newData.val() >= 1920 && newData.val() <= 2040 && newData.val() % 1 === 0"
            },
            "uid": {
              ".validate": "newData.isString() && newData.val().matches(/^[-_A-Za-z0-9]{1,32}$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 300000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "codes": {
      "$code": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous'",
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && ((!data.exists() && newData.parent().parent().child('groups').child(newData.child('gid').val()).child('owner').val() === auth.uid && newData.parent().parent().child('groups').child(newData.child('gid').val()).child('codes').child($code).exists()) || (data.exists() && !newData.exists() && root.child('groups').child(data.child('gid').val()).child('owner').val() === auth.uid && !newData.parent().parent().child('groups').child(data.child('gid').val()).child('codes').child($code).exists()) || (data.exists() && newData.exists() && newData.child('gid').val() === data.child('gid').val() && newData.child('name').val() !== data.child('name').val() && root.child('groups').child(data.child('gid').val()).child('owner').val() === auth.uid))",
        ".validate": "$code.matches(/^[A-Za-z0-9]{10,32}$/) && newData.hasChildren(['gid', 'name'])",
        "gid": {
          ".validate": "newData.isString() && newData.val().matches(/^[-_A-Za-z0-9]{1,32}$/)"
        },
        "name": {
          ".validate": "newData.isString() && newData.val() === newData.parent().parent().parent().child('groups').child(newData.parent().child('gid').val()).child('name').val()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "groups": {
      "$gid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && data.child('members').child(auth.uid).exists()",
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && ((!data.exists() && newData.child('owner').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('owner').val() === auth.uid))",
        ".validate": "$gid.matches(/^[-_A-Za-z0-9]{1,32}$/) && newData.hasChildren(['name', 'owner', 'createdAt', 'members']) && (data.exists() || (newData.child('members').child(auth.uid).exists() && !newData.child('profiles').exists() && !newData.child('banned').exists()))",
        "name": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && root.child('groups').child($gid).child('owner').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
        },
        "owner": {
          ".validate": "newData.val() === auth.uid"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 300000"
        },
        "codes": {
          ".validate": "newData.hasChildren()",
          "$c": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && root.child('groups').child($gid).child('owner').val() === auth.uid && (newData.exists() || !newData.parent().parent().parent().parent().child('codes').child($c).exists())",
            ".validate": "$c.matches(/^[A-Za-z0-9]{10,32}$/) && newData.isNumber() && newData.val() > 0 && newData.val() <= now + 300000 && newData.parent().parent().parent().parent().child('codes').child($c).child('gid').val() === $gid"
          }
        },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (($uid === auth.uid && newData.exists() && root.child('groups').child($gid).child('owner').exists() && !root.child('groups').child($gid).child('banned').child(auth.uid).exists()) || (data.exists() && !newData.exists() && (($uid === auth.uid && root.child('groups').child($gid).child('owner').val() !== auth.uid) || (root.child('groups').child($gid).child('owner').val() === auth.uid && $uid !== auth.uid))))",
            ".validate": "$uid.matches(/^[-_A-Za-z0-9]{1,32}$/) && newData.hasChildren(['name', 'via']) && (data.exists() || $uid === auth.uid)",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
            },
            "via": {
              ".validate": "newData.isString() && ((newData.val() === 'owner' && $uid === newData.parent().parent().parent().child('owner').val()) || newData.parent().parent().parent().parent().parent().child('codes').child(newData.val()).child('gid').val() === $gid)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "banned": {
          ".validate": "newData.hasChildren()",
          "$uid": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && root.child('groups').child($gid).child('owner').val() === auth.uid && $uid !== auth.uid",
            ".validate": "$uid.matches(/^[-_A-Za-z0-9]{1,32}$/) && newData.val() === true"
          }
        },
        "profiles": {
          "$uid": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && ((newData.exists() && $uid === auth.uid && newData.parent().parent().child('members').child(auth.uid).exists()) || (!newData.exists() && ($uid === auth.uid || root.child('groups').child($gid).child('owner').val() === auth.uid)))",
            ".validate": "$uid.matches(/^[-_A-Za-z0-9]{1,32}$/) && newData.hasChildren(['w', 'c', 'n', 'updatedAt'])",
            "w": {
              ".validate": "newData.hasChildren()",
              "$t": {
                ".validate": "$t.matches(/^[a-z_]{1,24}$/) && newData.isNumber() && newData.val() >= -1 && newData.val() <= 1"
              }
            },
            "c": {
              ".validate": "newData.hasChildren()",
              "$t": {
                ".validate": "$t.matches(/^[a-z_]{1,24}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
              }
            },
            "n": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500 && newData.val() % 1 === 0"
            },
            "prefs": {
              ".validate": "newData.hasChildren()",
              "airco": {
                ".validate": "newData.isBoolean()"
              },
              "ev": {
                ".validate": "newData.isBoolean()"
              },
              "kids": {
                ".validate": "newData.isBoolean()"
              },
              "budget": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4 && newData.val() % 1 === 0"
              },
              "$other": {
                ".validate": false
              }
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 300000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "trip": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && newData.exists() && root.child('groups').child($gid).child('members').child(auth.uid).exists() && !root.child('groups').child($gid).child('banned').child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['dest', 'nights', 'updatedAt'])",
          "dest": {
            ".validate": "newData.isString() && newData.val().matches(/^[-_A-Za-z0-9]{1,32}$/)"
          },
          "nights": {
            ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 28 && newData.val() % 1 === 0"
          },
          "start": {
            ".validate": "newData.isString() && newData.val().matches(/^20[2-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/)"
          },
          "end": {
            ".validate": "newData.isString() && newData.val().matches(/^20[2-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/)"
          },
          "months": {
            ".validate": "newData.isString() && newData.val().matches(/^20[2-9][0-9]-(0[1-9]|1[0-2])( 20[2-9][0-9]-(0[1-9]|1[0-2])){0,2}$/)"
          },
          "party": {
            ".validate": "newData.hasChildren()",
            "$p": {
              ".validate": "$p.matches(/^p([0-9]|1[01])$/) && newData.hasChildren(['name'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
              },
              "born": {
                ".validate": "newData.isNumber() && newData.val() >= 1920 && newData.val() <= 2040 && newData.val() % 1 === 0"
              },
              "uid": {
                ".validate": "newData.isString() && newData.val().matches(/^[-_A-Za-z0-9]{1,32}$/)"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "pace": {
            ".validate": "newData.isString() && (newData.val() === 'calm' || newData.val() === 'normal' || newData.val() === 'active')"
          },
          "highlights": {
            ".validate": "newData.isString() && newData.val().length <= 1000 && newData.val().matches(/^[-a-z0-9 ]*$/)"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 300000"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
